# ==============================================================================
# NEXUS Organization OS — Production Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security & CORS
SECRET_KEY=generate-a-strong-random-64-character-hex-key-here
ALLOWED_ORIGINS=https://nexus.yourdomain.com,http://localhost

# Database Connection (PostgreSQL 16 + pgvector)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-secure-database-password
POSTGRES_DB=nexus_db
DATABASE_URL=postgresql+asyncpg://nexus:replace-with-a-secure-database-password@db:5432/nexus_db

# Redis 7 Event Bus & Cache
REDIS_URL=redis://redis:6379/0

# Rate Limiting & Concurrency
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
WORKER_CONCURRENCY=4
TASK_TIMEOUT_SEC=120

# AI Provider Gateway
# Set PRIMARY_PROVIDER to: gemini | anthropic | openai | qwen
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=anthropic
DEMO_REPLAY=false

# API Keys (Provide at least one live provider key)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
ANTHROPIC_API_KEY=sk-ant-api03-YourAnthropicKeyHere
OPENAI_API_KEY=sk-proj-YourOpenAIKeyHere

# Optional Self-Hosted Qwen2.5 / vLLM Endpoint
QWEN_ENABLED=false
QWEN_BASE_URL=http://vllm:8000/v1
QWEN_API_KEY=
