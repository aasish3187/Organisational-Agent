# ==============================================================================
# ORGagent Organization OS — Enterprise Multi-Provider Environment Template
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
APP_NAME="ORGagent Organization OS"
VERSION="1.0.0"

# Database Configuration (PostgreSQL for Docker/Production, SQLite for Dev)
# DATABASE_URL=postgresql+asyncpg://nexus:nexus_secret@localhost:5432/nexus_db
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# Redis Event Bus & Queue
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Worker Concurrency
RATE_LIMIT_PER_MINUTE=120
WORKER_CONCURRENCY=4

# ==============================================================================
# Multi-Model AI Routing & LLM Gateway
# ==============================================================================
# Supported Providers: gemini | groq | openrouter | openai | anthropic | qwen | ollama
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDER=groq
MODEL_POLICY=AUTO          # STRICT | BALANCE | NOCAP | AUTO

# 1. Google Gemini API (Recommended for deep reasoning & low latency)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash

# 2. DeepSeek API (DeepSeek-R1 Reasoning & DeepSeek-V3)
# Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_PRO=deepseek-reasoner
DEEPSEEK_MODEL_FLASH=deepseek-chat

# 3. Zhipu AI GLM API (GLM-5.2 General Language Model)
# Get key: https://open.bigmodel.cn/
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL_PRO=glm-5.2
GLM_MODEL_FLASH=glm-4-flash

# 4. Groq Cloud (Ultra-Fast 500+ tokens/sec inference)
# Get key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 5. OpenRouter (Universal Multi-Model Aggregator with DeepSeek-R1 & GLM)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 6. OpenAI API
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_PRO=gpt-4o
OPENAI_MODEL_FLASH=gpt-4o-mini

# 7. Anthropic Claude API
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRO=claude-3-7-sonnet-latest
ANTHROPIC_MODEL_FLASH=claude-3-5-haiku-latest

# 6. Alibaba Cloud Qwen / DashScope
# Get key: https://bailian.console.aliyun.com/
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 7. Local Private Ollama (Zero API Keys required)
# Install: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# ==============================================================================
# Frontend Configuration
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_REPLAY=false
