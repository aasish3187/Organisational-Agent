# ==========================================
# NEXUS Organization OS — Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL for production/docker, SQLite for dev/test)
# PostgreSQL: postgresql+asyncpg://nexus:nexus_secret@localhost:5432/nexus_db
# SQLite: sqlite+aiosqlite:///./nexus.db
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# Redis (SSE fan-out and pub-sub)
REDIS_URL=redis://localhost:6379/0

# Demo / Replay Mode
DEMO_REPLAY=true

# Model Providers & Routing
PRIMARY_PROVIDER=anthropic # anthropic | openai
MODEL_POLICY=AUTO          # STRICT | BALANCE | NOCAP | AUTO
QWEN_ENABLED=false
QWEN_BASE_URL=http://localhost:8000/v1

# API Keys (Provide in your real .env only; NEVER commit keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_REPLAY=true
